{
  "name": "@scotthaney323/react-figma",
  "version": "0.33.0",
  "description": "Render React components to Figma",
  "scripts": {
    "tsc": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "prettify": "prettier \"src/**/*.{js,jsx,ts,tsx}\" \"examples/**/*.{js,jsx,ts,tsx}\" --ignore-path ./.prettierignore --write",
    "prettier:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx}\" \"examples/**/*.{js,jsx,ts,tsx}\"",
    "build": "npm run build:clean && npm run build:lib",
    "build:clean": "rimraf dist",
    "build:lib": "cross-env BABEL_ENV=production tsc -p tsconfig.json"
  },
  "jest": {
    "preset": "ts-jest/presets/js-with-babel",
    "setupFiles": [
      "<rootDir>/setup.jest.js"
    ]
  },
  "author": "Ilya Lesik <ilialesik@gmail.com>",
  "license": "MIT",
  "pre-commit": [
    "prettify",
    "tsc",
    "test"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/react-figma/react-figma.git"
  },
  "keywords": [
    "figma",
    "react",
    "figma-plugins"
  ],
  "engines": {
    "node": ">=10.0.0 <22.0.0"
  },
  "devDependencies": {
    "@figma/plugin-typings": "1.64.0",
    "@types/jest": "^24.0.18",
    "@types/node": "^12.7.8",
    "@types/react": "16.9.0",
    "@types/react-native": "^0.63.50",
    "@types/yoga-layout": "^1.9.1",
    "babel-core": "^7.0.0-bridge.0",
    "babel-jest": "^29.7.0",
    "copyfiles": "^2.1.1",
    "cross-env": "^5.2.0",
    "css-loader": "^7.1.2",
    "figma-api-stub": "0.0.55",
    "file-loader": "^6.2.0",
    "@effortlessmotion/html-webpack-inline-source-plugin": "^1.0.3",
    "html-webpack-plugin": "^5.6.3",
    "jest": "^29.7.0",
    "jest-fetch-mock": "^3.0.3",
    "pre-commit": "^1.2.2",
    "prettier": "^1.18.2",
    "react": "16.9.0",
    "@scotthaney323/react-figma-webpack-config": "^5.0.0",
    "react-test-renderer": "16.9.0",
    "rimraf": "^3.0.0",
    "style-loader": "^4.0.0",
    "svg-inline-loader": "^0.8.2",
    "ts-jest": "^29.3.4",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "url-loader": "^4.1.1",
    "webpack": "^5.70.0",
    "webpack-cli": "^4.9.2"
  },
  "dependencies": {
    "color-parse": "1.3.8",
    "figma-jsonrpc": "^0.4.0",
    "nanoid": "3.3.8",
    "react-devtools-core": "^4.7.0",
    "react-fetch-hook": "1.7.2",
    "react-reconciler": "^0.23.0",
    "rxjs": "^6.5.2",
    "utility-types": "^3.10.0",
    "yoga-layout-prebuilt": "1.9.3"
  },
  "peerDependencies": {
    "react": "*"
  }
}
